# ============================================
# ACG-FAKA 环境变量配置样例
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================

# ---------- MySQL 数据库 ----------
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password

# ---------- 端口映射 ----------
# Web 服务对外端口（生产环境）
WEB_PORT=8080
# MySQL 对外端口（生产环境）
MYSQL_PORT=3307

# 开发环境端口（仅 docker-compose.dev.yml 使用）
WEB_DEV_PORT=8081
MYSQL_DEV_PORT=3308
REDIS_DEV_PORT=6379
PHPMYADMIN_PORT=8082

# ---------- 自助充值 ----------
# PHP 后台与 Next 前台共享的内部密钥（至少 16 位），前台据此读取后台「充值商家」配置。
# 两边必须一致：Next 侧写在 frontend/.env.local（或部署环境变量）。生成：openssl rand -hex 32
RECHARGE_INTERNAL_KEY=
